<Window x:Class="practices.ObjectDynamic"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practices"
        mc:Ignorable="d"
        Title="Object and Dynamic Types" Height="400" Width="500" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="25">

        <TextBlock Text="Object and Dynamic Types"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10,0,25"/>

        <Button Content="Object Type"
            Height="40"
                Name="objclick"
            Margin="0,0,0,10"
            Click="objclick_Click"/>

        <Button Content="Dynamic Type"
            Height="40"
                Name="dynamic"
            Margin="0,0,0,15"
            Click="dynamic_Click"/>

        <TextBlock Text="Output:"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,5,0,5"/>

        <TextBlock x:Name="txtOutput"
               FontSize="16"
               TextWrapping="Wrap"/>

    </StackPanel>

</Window>